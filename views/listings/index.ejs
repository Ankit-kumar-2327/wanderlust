<%- layout("/layouts/boilerplate") %>
<body>
    <style>
        #filters {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
        }
        .filter {
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-width: 92px;
            padding: 0.7rem 0.9rem;
            margin-right: 1rem;
            margin-top: 1rem;
            border: 1px solid #e5e7eb;
            border-radius: 999px;
            background-color: #fff;
            color: #4b5563;
            opacity: 0.95;
            transition: all 0.2s ease;
            appearance: none;
        }
        .filter:hover {
            opacity: 1;
            cursor: pointer;
            color: #ff385c;
            border-color: #ff385c;
            box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
        }
        .filter p {
            font-size: 0.8rem;
            margin: 0.25rem 0 0;
        }
        .filter i {
            color: #ff385c;
            font-size: 1.15rem;
        }
        .listing-card {
            position: relative;
        }
        .listing-heart {
            position: absolute;
            top: 0.8rem;
            right: 0.8rem;
            color: #ff385c;
            font-size: 1.2rem;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
        }
    </style>
    <div id="filters" class="mb-3">
        <button class="filter" type="button">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </button>
        <button class="filter" type="button">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </button>
        <button class="filter" type="button">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic cities</p>
        </button>
        <button class="filter" type="button">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing pools</p>
        </button>
        <button class="filter" type="button">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </button>
        <button class="filter" type="button">
            <div><i class="fa-solid fa-snowflake"></i></div>
            <p>Arctic</p>
        </button>
        <button class="filter" type="button">
            <div><i class="fa-solid fa-ship"></i></div>
            <p>Boats</p>
        </button>
        <button class="filter" type="button">
            <div><i class="fa-solid fa-tent-arrow-down-to-line"></i></div>
            <p>Camping</p>
        </button>
        <button class="filter" type="button">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
        </button>
    </div>
    <br>
    <% if (typeof searchTerm !== 'undefined' && searchTerm) { %>
        <div class="text-center mb-3">
            <h5>Showing results for: <span class="text-danger"><%= searchTerm %></span></h5>
        </div>
    <% } %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
        <% for(let listing of allListings){ %>
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card col listing-card">
                    <i class="fa-solid fa-heart listing-heart"></i>
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="img-listing">
                    <div class="card-img-overlay">Guest favourite</div>
                    <div class="card-body">
                        <p class="card-text">
                            <b><%=listing.title%> </b><br>
                            &#8377;<%= listing.price.toLocaleString("en-IN")%>/night
                        </p>
                    </div>
                </div>
            </a>
        <% } %>
    </div>
</body>