<%- layout("/layouts/boilerplate") %>
<div class="py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <h1 class="mb-4">Privacy</h1>
      <p class="lead text-muted">
        Your privacy matters to wanderLust. We keep your personal data safe and
        only use it to make booking stays easier.
      </p>
      <div class="mt-4">
        <h5>What we collect</h5>
        <ul>
          <li>Basic account information like name, email, and password.</li>
          <li>
            Booking details and payment information to complete reservations.
          </li>
          <li>Optional profile information you choose to share with hosts.</li>
        </ul>
      </div>
      <div class="mt-4">
        <h5>How we use it</h5>
        <p>
          We use your information to process bookings, communicate trip details,
          and improve your experience on the site.
        </p>
      </div>
      <div class="mt-4">
        <h5>Sharing</h5>
        <p>
          We do not sell your information. We may share necessary booking
          details with hosts and service providers only when required to
          complete your stay.
        </p>
      </div>
      <div class="mt-5 text-center">
        <a class="btn btn-secondary btn-lg px-5" href="/listings" role="button">
          Back to Listings
        </a>
      </div>
    </div>
  </div>
</div>
