<%- layout("/layouts/boilerplate") %>
<div class="py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <h1 class="mb-4">Terms</h1>
      <p class="lead text-muted">
        These terms govern your use of wanderLust. By using the site, you agree
        to follow the policies below.
      </p>
      <div class="mt-4">
        <h5>Using wanderLust</h5>
        <p>
          Use the site for booking stays, reviewing listings, and connecting
          with hosts. Always provide accurate information and respect other
          users.
        </p>
      </div>
      <div class="mt-4">
        <h5>Content and behavior</h5>
        <p>
          Listings and reviews should be honest and lawful. Do not post abusive
          or misleading content.
        </p>
      </div>
      <div class="mt-4">
        <h5>Liability</h5>
        <p>
          wanderLust provides the platform and does not own listings. We are not
          responsible for the accuracy of each listing or for disputes between
          guests and hosts.
        </p>
      </div>
      <div class="mt-5 text-center">
        <a class="btn btn-primary btn-lg px-5" href="/listings" role="button">
          Back to Listings
        </a>
      </div>
    </div>
  </div>
</div>
